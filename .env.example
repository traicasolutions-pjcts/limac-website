# Limac Website And Warranty Environment Example
# Copy needed values into .env.local for local development.
# Configure production values in Vercel for frontend and Render for backend.
# Do not commit real secrets.


# -----------------------------------------------------------------------------
# FRONTEND - Vercel / browser-visible
# -----------------------------------------------------------------------------
# Add these in Vercel for the Next.js frontend.
# These values are exposed to the browser because they start with NEXT_PUBLIC_.

# Required for production frontend.
NEXT_PUBLIC_SITE_URL=https://www.limac.in
NEXT_PUBLIC_WARRANTY_API_URL=http://127.0.0.1:8000/api/v1

# Required only when captcha is enabled for warranty registration.
# Get this from Cloudflare Turnstile. This is the public site key.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=


# -----------------------------------------------------------------------------
# EXISTING NEXT/PAYLOAD WEBSITE - Vercel server-side
# -----------------------------------------------------------------------------
# Add these in Vercel for the existing website runtime.
# Keep secrets server-side only.

# Required by Payload CMS runtime.
PAYLOAD_URL=http://localhost:3000
PAYLOAD_SECRET=

# Optional for current warranty V1. Leave blank unless Payload API key auth is enabled.
PAYLOAD_API_KEY=

# Product source for current product pages: csv, cms, or hybrid.
PRODUCT_DATA_SOURCE=csv


# -----------------------------------------------------------------------------
# SHARED DATABASE - server-side only
# -----------------------------------------------------------------------------
# Add this wherever the server process needs MongoDB:
# - Vercel, if the Next/Payload website uses MongoDB.
# - Render, for the warranty FastAPI backend.
#
# Local Docker Mongo example:
# MONGODB_URI=mongodb://localhost:27018
#
# MongoDB Atlas production example:
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/limac?retryWrites=true&w=majority

# Required for warranty backend.
MONGODB_URI=mongodb://localhost:27018
MONGODB_DATABASE=limac


# -----------------------------------------------------------------------------
# BACKEND - Warranty FastAPI / Render server-side only
# -----------------------------------------------------------------------------
# Add these in Render for the warranty FastAPI backend.
# Never put these secret values in frontend/browser env.

# Required for warranty backend.
ENVIRONMENT=development
JWT_SECRET_KEY=

# Required for backend captcha enforcement.
# This controls whether backend rejects requests without a valid Turnstile token.
# For local development without captcha, use TURNSTILE_REQUIRED=false.
TURNSTILE_REQUIRED=true

# Required when TURNSTILE_REQUIRED=true.
# Get this from Cloudflare Turnstile. This is the secret key, not the site key.
TURNSTILE_SECRET_KEY=

# Required for bill image upload/storage.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_BILL_FOLDER_ROOT=limac/warranty-bills

# Required only for first backend startup if no warranty admin user exists yet.
# Remove INITIAL_ADMIN_PASSWORD from Render after first successful bootstrap.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Future Tally integration contract. Keep disabled for V1 unless explicitly enabled.
INTEGRATION_TALLY_ENABLED=false
INTEGRATION_BEARER_TOKEN=


# -----------------------------------------------------------------------------
# Not required for warranty V1
# -----------------------------------------------------------------------------
# SMS, OTP, Resend, SMTP, WhatsApp, and outbound email providers are intentionally
# not required by the warranty V1 implementation.
